# Copy to `.env.local` (git-ignored) and fill in your own values. Never commit real values.

# Public key from the extension key pair, so the unpacked extension keeps a stable ID.
# Paste the base64 public key only (no PEM header). Keep the private .pem out of the repo.
WXT_EXTENSION_PUBLIC_KEY=

# Chrome extension OAuth client ID from your Google Cloud project (Gmail API enabled).
# Not a secret, but account-specific. Leave empty to build without Gmail import.
WXT_GOOGLE_OAUTH_CLIENT_ID=

# Public builds only: HTTPS URL of the wording proxy (server/wording-proxy) that holds the
# OpenAI key server-side. When set, the extension never asks for or stores a key.
WXT_WORDING_PROXY_URL=

# The OpenAI API key is NOT configured here. Paste it into Worth It's settings page;
# it is stored only in chrome.storage.local on your machine.
